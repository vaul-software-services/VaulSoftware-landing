---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import CTA from "../../components/CTA.astro";
import { locales, resolveLocale } from "../../lib/i18n";
import { getContent } from "../../data/content";
import WorkFeature from "../../components/WorkFeature.astro";
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = resolveLocale(Astro.params.lang);
const t = getContent(lang);
const messages = {
  title: `${t.work} | Vaul Software`,
  description: t.workPageIntro,
};
---

<BaseLayout lang={lang} messages={messages}>
  <Header lang={lang} />
  <main id="main" tabindex="-1">
    <section class="page-hero">
      <div class="wrap">
        <span class="eyebrow">{t.work}</span>
        <h1 class="display">{t.workPageTitle}</h1>
        <p class="intro">{t.workPageIntro}</p>
      </div>
    </section>
    <section class="section">
      <div class="wrap">
        <WorkFeature lang={lang} />
      </div>
    </section>
    <CTA lang={lang} />
  </main>
</BaseLayout>
