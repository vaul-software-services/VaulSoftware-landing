---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import CTA from "../../components/CTA.astro";
import Arrow from "../../components/Arrow.astro";
import { locales, resolveLocale } from "../../lib/i18n";
import { getContent } from "../../data/content";
import ProductFeature from "../../components/ProductFeature.astro";
import { products } from "../../data/projects";
import { itemListNode } from "../../lib/schema";
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = resolveLocale(Astro.params.lang);
const t = getContent(lang);
const messages = {
  title: `${t.products} | Vaul Software`,
  description: t.productsIntro,
};
const canonical = `https://vaulsoftware.com/${lang}/products/`;
const breadcrumbs = [
  { name: t.home, path: `/${lang}/` },
  { name: t.products, path: `/${lang}/products/` },
];
const schema = [
  itemListNode(
    canonical,
    t.productsTitle,
    products.map((product) => ({
      name: product.name,
      description: product.content[lang].description,
      path: `/${lang}/products/${product.slug}/`,
    })),
  ),
];
---

<BaseLayout
  lang={lang}
  messages={messages}
  pageType="CollectionPage"
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  <Header lang={lang} />
  <main id="main" tabindex="-1">
    <section class="page-hero">
      <div class="wrap">
        <span class="eyebrow">{t.products}</span>
        <h1 class="display">{t.productsTitle}</h1>
        <p class="intro">{t.productsIntro}</p>
      </div>
    </section>
    <ProductFeature lang={lang} />
    <section class="section">
      <div class="wrap two-col">
        <h2 class="heading">{t.productProblem}</h2>
        <div>
          <p class="intro">{t.productBody}</p>
          <p class="intro mt-5">{t.productNote}</p>
          <a
            class="text-link mt-5"
            href={`https://getcourtrank.com/${lang}/`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.productVisit}
            <Arrow />
          </a>
        </div>
      </div>
    </section>
    <CTA lang={lang} />
  </main>
</BaseLayout>
