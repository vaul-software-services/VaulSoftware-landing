---
import StockPhoto from "../../components/StockPhoto.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import CTA from "../../components/CTA.astro";
import Arrow from "../../components/Arrow.astro";
import { locales, resolveLocale } from "../../lib/i18n";
import { getContent } from "../../data/content";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = resolveLocale(Astro.params.lang);
const t = getContent(lang);
const messages = {
  title: `${t.about} | Vaul Software`,
  description: t.aboutIntro,
};
---

<BaseLayout lang={lang} messages={messages}>
  <Header lang={lang} />
  <main id="main" tabindex="-1">
    <section class="page-hero">
      <div class="wrap">
        <span class="eyebrow">{t.about}</span>
        <h1 class="display">{t.aboutTitle}</h1>
        <p class="intro">{t.aboutIntro}</p>
        <div class="founder-intro">
          <div>
            <p class="founder-role">
              {lang === "es"
                ? "Fundador de Vaul Software"
                : "Founder of Vaul Software"}
            </p>
            <p class="founder-name">Sebastián Sánchez</p>
            <p class="founder-description">
              {lang === "es"
                ? "Conoce su trabajo y trayectoria en su portafolio personal."
                : "Explore his work and background in his personal portfolio."}
            </p>
          </div>
          <a
            class="founder-portfolio"
            href="https://www.sebas3261.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>
              {lang === "es" ? "Ver portafolio" : "View portfolio"}{" "}
              <span aria-hidden="true">↗</span>
            </span>
            <span class="portfolio-domain">sebas3261.com</span>
          </a>
        </div>
      </div>
    </section>
    <section class="section">
      <div class="wrap two-col items-center">
        <StockPhoto lang={lang} image="planning" />
        <div>
          <h2 class="heading">{t.aboutHeading}</h2>
          <p class="intro mt-6">{t.aboutBody}</p>
        </div>
      </div>
    </section>
    <section class="section purpose">
      <div class="wrap purpose-grid">
        <div>
          <span class="eyebrow">{t.purposeLabel}</span>
          <h2 class="heading">{t.purposeHeading}</h2>
          <p class="intro mt-6">{t.purposeDesc}</p>
        </div>
        <div class="principles">
          {t.principles.map((p) => (
            <div class="principle">
              <h3>{p[0]}</h3>
              <p>{p[1]}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="section">
      <div class="wrap two-col">
        <div>
          <span class="eyebrow">{t.founderLabel}</span>
          <h2 class="heading">{t.founderTitle}</h2>
        </div>
        <div>
          <p class="intro">{t.founderBody}</p>
          <a
            class="text-link mt-6"
            href="https://www.sebas3261.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.portfolio}
            <Arrow />
          </a>
        </div>
      </div>
    </section>
    <CTA lang={lang} />
  </main>
</BaseLayout>

<style>
  .founder-intro {
    margin-top: 34px;
    max-width: 790px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 26px 30px;
    border: 1px solid color-mix(in srgb, var(--link) 30%, var(--line));
    border-left: 3px solid #2563eb;
    border-radius: 6px;
    background: color-mix(in srgb, #2563eb 5%, var(--surface));
  }
  .founder-role {
    font-size: 12px;
    font-weight: 600;
    color: var(--link);
    letter-spacing: 0.055em;
    text-transform: uppercase;
    line-height: 1.7;
  }
  .founder-name {
    font-size: 27px;
    font-weight: 600;
    letter-spacing: -0.04em;
    margin-top: 6px;
  }
  .founder-description {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.8;
    margin-top: 7px;
    max-width: 410px;
  }
  .founder-portfolio {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex-shrink: 0;
    min-height: 58px;
    padding: 14px 20px;
    border-radius: 5px;
    background: #2563eb;
    color: white;
    transition: background 0.2s;
  }
  .founder-portfolio:hover {
    background: #1d4ed8;
  }
  .founder-portfolio > span:first-child {
    display: flex;
    justify-content: space-between;
    gap: 26px;
    font-size: 15px;
    font-weight: 600;
  }
  .portfolio-domain {
    font-size: 12px;
    opacity: 0.9;
  }
  @media (max-width: 767px) {
    .founder-intro {
      flex-direction: column;
      align-items: flex-start;
      gap: 22px;
      padding: 24px;
    }
    .founder-portfolio {
      width: 100%;
    }
    .founder-name {
      font-size: 25px;
    }
  }
</style>
