---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import CTA from "../../../components/CTA.astro";
import ProductFeature from "../../../components/ProductFeature.astro";
import Arrow from "../../../components/Arrow.astro";
import { locales, resolveLocale } from "../../../lib/i18n";
import { getContent } from "../../../data/content";
import { products } from "../../../data/projects";
export function getStaticPaths() {
  return locales.flatMap((lang) =>
    products.map((product) => ({
      params: { lang, product: product.slug },
      props: { product },
    })),
  );
}
const lang = resolveLocale(Astro.params.lang);
const t = getContent(lang);
const { product } = Astro.props;
const c = product.content[lang];
const messages = {
  title: `${product.name} | ${t.products} | Vaul Software`,
  description: c.description,
};
---

<BaseLayout lang={lang} messages={messages}>
  <Header lang={lang} />
  <main id="main" tabindex="-1">
    <section class="page-hero">
      <div class="wrap">
        <nav
          class="breadcrumb"
          aria-label={lang === "es" ? "Ruta de navegación" : "Breadcrumb"}
        >
          <a href={`/${lang}/products/`}>{t.products}</a>
          <span aria-hidden="true">/</span>
          <span>{product.name}</span>
        </nav>
        <span class="eyebrow">{t.products}</span>
        <h1 class="display">
          {product.name}
          <span class="text-brand">.</span>
        </h1>
        <p class="intro">{c.body}</p>
      </div>
    </section>
    <ProductFeature lang={lang} detail slug={product.slug} />
    <section class="section">
      <div class="wrap two-col">
        <h2 class="heading">{c.problem}</h2>
        <div>
          <p class="intro">{t.productNote}</p>
          <a
            class="text-link mt-6"
            href={`${product.url}${lang}/features/`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.productStatus}
            <Arrow />
          </a>
        </div>
      </div>
    </section>
    <CTA lang={lang} />
  </main>
</BaseLayout>
