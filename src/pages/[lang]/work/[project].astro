---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import CTA from "../../../components/CTA.astro";
import ProjectMedia from "../../../components/ProjectMedia.astro";
import Arrow from "../../../components/Arrow.astro";
import { locales, resolveLocale } from "../../../lib/i18n";
import { getContent } from "../../../data/content";
import { projects } from "../../../data/projects";
export function getStaticPaths() {
  return locales.flatMap((lang) =>
    projects.map((project) => ({
      params: { lang, project: project.slug },
      props: { project },
    })),
  );
}
const lang = resolveLocale(Astro.params.lang);
const t = getContent(lang);
const { project } = Astro.props;
const c = project.content[lang];
const messages = {
  title: `${project.name} | ${t.work} | Vaul Software`,
  description: c.summary,
};
---

<BaseLayout lang={lang} messages={messages}>
  <Header lang={lang} />
  <main id="main" tabindex="-1">
    <section class="page-hero">
      <div class="wrap">
        <nav
          class="breadcrumb"
          aria-label={lang === "es" ? "Ruta de navegación" : "Breadcrumb"}
        >
          <a href={`/${lang}/work/`}>{t.work}</a>
          <span aria-hidden="true">/</span>
          <span>{project.name}</span>
        </nav>
        <span class="eyebrow">{c.category}</span>
        <h1 class="display">
          {project.name}
          <span class="text-brand">.</span>
        </h1>
        <p class="intro">{c.summary}</p>
        <div class="stack">
          {project.technologies.map((tech: string) => (
            <span>{tech}</span>
          ))}
        </div>
        <a
          class="text-link"
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.live}
          <Arrow />
        </a>
      </div>
    </section>
    <section class="section">
      <div class="wrap">
        <ProjectMedia
          lang={lang}
          src={project.image}
          alt={c.caption}
          url={new URL(project.url).hostname}
        />
        <div class="mt-10">
          {project.gallery.map((image) => (
            <ProjectMedia
              lang={lang}
              src={image.src}
              alt={image.alt[lang]}
              url={image.url}
            />
          ))}
        </div>
      </div>
    </section>
    <section class="section purpose">
      <div class="wrap two-col">
        {[
          [t.context, c.context],
          [t.challenge, c.challenge],
          [t.solution, c.solution],
          [t.outcome, c.outcome],
        ].map(([heading, body]) => (
          <article>
            <h2 class="heading !text-3xl">{heading}</h2>
            <p class="intro mt-5">{body}</p>
          </article>
        ))}
      </div>
    </section>
    <CTA lang={lang} />
  </main>
</BaseLayout>
