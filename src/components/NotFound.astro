---
import "../styles/global.css";
import en from "../messages/en/404.json";
import es from "../messages/es/404.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import type { Locale } from "../lib/i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const messages = lang === "es" ? es : en;
---

<BaseLayout lang={lang} messages={messages} noindex>
  <Header lang={lang} />

  <main
    id="main"
    tabindex="-1"
    class="mx-auto max-w-6xl px-6 py-24 text-center"
  >
    <h1 class="text-3xl font-semibold tracking-tight text-ink sm:text-5xl">
      {messages.heading}
    </h1>
    <p class="mt-4 text-base text-slate">{messages.body}</p>
    <a
      href={`/${lang}/`}
      class="mt-8 inline-flex items-center justify-center bg-brand px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-brand-strong"
    >
      {messages.cta}
    </a>
  </main>
</BaseLayout>
