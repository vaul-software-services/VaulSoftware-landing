---
import { getContent } from "../data/content";
import type { Locale } from "../lib/i18n";
const {
  lang,
  product = false,
  src,
  alt,
  url,
} = Astro.props as {
  lang: Locale;
  product?: boolean;
  src?: string;
  alt?: string;
  url?: string;
};
const t = getContent(lang);
---

<figure>
  <div class="media">
    <div class="media-bar" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
      <span>{url ?? (product ? "getcourtrank.com" : "playzonevip.com")}</span>
    </div>
    <img
      src={
        src ??
        (product ? "/images/courtrank-site.webp" : "/images/playzone-vip.webp")
      }
      alt={alt ?? (product ? t.productCaption : t.workCaption)}
      width="1280"
      height="720"
      loading="lazy"
      decoding="async"
    />
  </div>
  <figcaption class="media-caption">
    {alt ?? (product ? t.productCaption : t.workCaption)}
  </figcaption>
</figure>
