---
import type { Locale } from "../lib/i18n";
import { pricingCopy } from "../data/pricing";
import CurrencySelector from "./CurrencySelector.astro";
import PricingCards from "./PricingCards.astro";
import Arrow from "./Arrow.astro";
const { lang } = Astro.props as { lang: Locale };
const t = pricingCopy[lang];
---

<section class="section pricing-preview">
  <div class="wrap">
    <span class="eyebrow">{t.nav}</span>
    <div class="section-head">
      <h2 class="heading max-w-xl">{t.heading}</h2>
      <p class="intro">{t.intro}</p>
    </div>
    <CurrencySelector lang={lang} />
    <PricingCards lang={lang} compact />
    <div class="pricing-preview-foot">
      <p>{t.launchNote}</p>
      <a class="text-link" href={`/${lang}/pricing/`}>
        {t.details}
        <Arrow />
      </a>
    </div>
  </div>
</section>
<style>
  .pricing-preview {
    border-top: 1px solid var(--line);
  }
  .pricing-preview-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-top: 25px;
  }
  .pricing-preview-foot p {
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
    max-width: 600px;
  }
  @media (max-width: 767px) {
    .pricing-preview-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>
