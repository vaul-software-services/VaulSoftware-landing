---
import type { Locale } from "../lib/i18n";
const { lang } = Astro.props as { lang: Locale };
const label =
  lang === "es" ? "Escríbenos por WhatsApp" : "Message us on WhatsApp";
const message =
  lang === "es"
    ? "Hola, me interesa hablar sobre un proyecto con Vaul Software."
    : "Hi, I would like to discuss a project with Vaul Software.";
const url = `https://wa.me/573134874660?text=${encodeURIComponent(message)}`;
---

<a
  class="whatsapp-button"
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
>
  <span class="whatsapp-label" aria-hidden="true">
    {label}
  </span>
  <!-- WhatsApp mark from Simple Icons (CC0). -->
  <svg
    viewBox="0 0 24 24"
    width="28"
    height="28"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
  </svg>
</a>
<style>
  .whatsapp-button {
    position: fixed;
    right: max(24px, env(safe-area-inset-right));
    bottom: calc(24px + env(safe-area-inset-bottom));
    z-index: 40;
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #25d366;
    color: white;
    box-shadow: 0 4px 18px rgb(0 0 0 / 0.18);
    border: 1px solid rgb(255 255 255 / 0.2);
    transition:
      background 0.2s,
      box-shadow 0.2s,
      transform 0.25s;
  }
  .whatsapp-button::before {
    content: "";
    position: absolute;
    inset: -1px;
    border: 2px solid #25d366;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .whatsapp-button::before {
      animation: whatsapp-pulse 5s ease-out 1s infinite;
    }
    .whatsapp-button:hover {
      transform: scale(1.06);
    }
    .whatsapp-button:hover::before,
    .whatsapp-button:focus-visible::before {
      animation-play-state: paused;
      opacity: 0;
    }
    .whatsapp-button:active {
      transform: scale(0.97);
    }
  }
  @keyframes whatsapp-pulse {
    0% {
      transform: scale(1);
      opacity: 0;
    }
    8% {
      opacity: 0.35;
    }
    35% {
      transform: scale(1.45);
      opacity: 0;
    }
    100% {
      transform: scale(1.45);
      opacity: 0;
    }
  }
  .whatsapp-button:hover {
    background: #1fbd5b;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.24);
  }
  .whatsapp-button:focus-visible {
    outline: 3px solid var(--link);
    outline-offset: 4px;
  }
  .whatsapp-label {
    position: absolute;
    right: calc(100% + 12px);
    white-space: nowrap;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--surface);
    color: var(--ink);
    padding: 10px 14px;
    font-size: 13px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }
  .whatsapp-button:hover .whatsapp-label,
  .whatsapp-button:focus-visible .whatsapp-label {
    opacity: 1;
  }
  @media (max-width: 767px) {
    .whatsapp-button {
      right: max(18px, env(safe-area-inset-right));
      bottom: calc(18px + env(safe-area-inset-bottom));
      width: 50px;
      height: 50px;
    }
    .whatsapp-label {
      display: none;
    }
  }
</style>
