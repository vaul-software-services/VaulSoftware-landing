---
interface Props {
  tone?: "dark" | "light";
  monochrome?: boolean;
  class?: string;
}
const { tone, monochrome = false, class: className = "" } = Astro.props;
---

<span
  class:list={["brand-logo", className, { "force-light": tone === "light" }]}
  aria-hidden="true"
>
  <span class="brand-symbol">
    <img
      class="logo-light"
      src={`/images/brand/${monochrome ? "vaul-black" : "vaul-color"}.svg`}
      alt=""
      width="48"
      height="30"
    />
    <img
      class="logo-dark"
      src="/images/brand/vaul-white.svg"
      alt=""
      width="48"
      height="30"
    />
  </span>
  <span class="brand-name">
    Vaul<span>Software</span>
  </span>
</span>
<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    white-space: nowrap;
  }
  .brand-symbol {
    display: grid;
    width: 48px;
    flex-shrink: 0;
  }
  .brand-symbol img {
    grid-area: 1/1;
    display: block;
    width: 48px;
    height: 30px;
    object-fit: contain;
  }
  .brand-symbol .logo-dark {
    display: none;
  }
  :global(.dark) .logo-light,
  .force-light .logo-light {
    display: none;
  }
  :global(.dark) .brand-symbol .logo-dark,
  .force-light .brand-symbol .logo-dark {
    display: block;
  }
  .force-light {
    color: white;
  }
  .brand-name {
    display: flex;
    flex-direction: column;
    font-size: 24px;
    font-weight: 650;
    letter-spacing: -0.9px;
    line-height: 1.05;
  }
  .brand-name span {
    margin-top: 3px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.6px;
    text-transform: uppercase;
  }
  @media (max-width: 400px) {
    .brand-symbol,
    .brand-symbol img {
      width: 42px;
    }
    .brand-logo {
      gap: 10px;
    }
    .brand-name {
      font-size: 22px;
    }
  }
</style>
