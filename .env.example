# Cloudflare Web Analytics beacon token.
# Found in the Cloudflare dashboard under Analytics & Logs > Web Analytics.
# Leave unset to disable analytics (e.g. in local development).
PUBLIC_CF_BEACON_TOKEN=

# Existing configured mailbox. Confirm delivery before deployment.
PUBLIC_CONTACT_EMAIL=contact@vaulsoftware.com

# SERVER ONLY: configure as Cloudflare Pages secrets/variables, never PUBLIC_.
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=Vaul Software <contact@vaulsoftware.com>
# CONTACT_TO_EMAIL=contact@vaulsoftware.com

# Optional Google Analytics 4 measurement ID (G-...). Public build-time value.
PUBLIC_GA_MEASUREMENT_ID=
